{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Clipboard",
  "version": "0.1.0",
  "identifier": "dev.farhanlabib.universalclipboard",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Universal Clipboard",
        "width": 380,
        "height": 600,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
