<resources>
    <!-- Colors match Palette in Look.kt. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#82D5CC</item>
        <item name="android:colorAccent">#82D5CC</item>
        <item name="android:windowBackground">#0E1513</item>
        <item name="android:statusBarColor">#0E1513</item>
        <item name="android:navigationBarColor">#0E1513</item>
    </style>
    <style name="AppTheme.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
